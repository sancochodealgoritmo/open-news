PORT=3000
NODE_ENV=production

# Notion — registro y presentación (IDs vigentes al 7-oct-2026, sección 9.4).
# El navegador nunca habla con Notion; estas claves viven solo en el servidor.
NOTION_TOKEN=ntn_xxx
NOTION_DB_FICHAS=4104b5059e974566b153601967ece83b
NOTION_DB_REVISIONES=7294bd94a80a4c638cb462e131653166
NOTION_DB_BITACORA=a8d46fc63a6446618ce7b182358ea6cd
NOTION_DB_REGLAS=2a8c476f292e4100ad0038334fd50bb8
NOTION_DB_PROMPTS=95ff3440f14f4f15a2e18ad9fda2227d
NOTION_DB_FUENTES=707376c5b3a54e25ac83021c1d2df963
NOTION_DB_EJECUCIONES=d1feba05e5ad451f86d2b60ff31b24cb
NOTION_DB_PRUEBAS=0bcc53461c50481e83c63c45a5afbf24
# Mapa nombre → user id de Notion para la propiedad people (JSON). Vacío = se omite.
NOTION_PEOPLE={}

# Proveedor de modelo con respaldo (solo en el servidor).
# Primario (DeepSeek por defecto). DEEPSEEK_API_KEY/DEEPSEEK_BASE_URL siguen siendo alias válidos.
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_MODEL_REASONER=deepseek-reasoner
# Secundario (respaldo ante caída del primario). Vacío = deshabilitado.
LLM2_API_KEY=
LLM2_BASE_URL=
LLM2_MODEL=
LLM2_MODEL_REASONER=
# Paralelismo del enriquecimiento IA (pool de concurrencia).
IA_CONCURRENCY=8

# Snapshot y modo sin internet.
SNAPSHOT_DIR=./data/snapshot
FECHA_CORTE_UTC=
MODO_OFFLINE=auto
